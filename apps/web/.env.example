# ============================================================
# Pickmysong — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ─── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Public URL and anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key — NEVER expose this in browser! Server-side only.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── App ──────────────────────────────────────────────────────
# Your app URL (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Optional: OAuth providers ────────────────────────────────
# Configure in Supabase Dashboard: Authentication > Providers

# Spotify OAuth (optional)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Setup Instructions ───────────────────────────────────────
# 1. Create a free project at https://supabase.com
# 2. Copy your project URL and anon key from Settings > API
# 3. Run migrations: supabase db push (or paste migration SQL in SQL Editor)
# 4. Run seed data: supabase db seed (or paste seed.sql in SQL Editor)
# 5. Copy this file: cp .env.example .env.local
# 6. Fill in your values above
# 7. Start the dev server: npm run dev --filter=web
