# ============================================================
# Pickmysong - Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ---- Supabase ----------------------------------------------
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Public (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only - NEVER expose in browser!
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Prisma / Database -------------------------------------
# Supabase connection pooling (for Prisma)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (for Prisma migrations)
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ---- NextAuth ----------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_32_CHARS_MIN
NEXTAUTH_URL=http://localhost:3000

# ---- Google OAuth (NextAuth provider) ----------------------
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ---- Spotify API -------------------------------------------
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET

# Optional: For Web Playback SDK (requires Premium account)
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# ---- App ---------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Pickmysong

# ---- Optional: Analytics -----------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_HOTJAR_ID=XXXXXXX

# ---- Optional: Email (Resend / SendGrid) -------------------
# RESEND_API_KEY=re_XXXXXXXX
# EMAIL_FROM=noreply@pickmysong.com
